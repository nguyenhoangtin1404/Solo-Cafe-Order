# App URL — dùng để generate QR code
NEXT_PUBLIC_APP_URL=https://your-cafe.vercel.app

# Supabase — lấy từ: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Chỉ dùng server-side — KHÔNG expose client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Rate limiting — lấy từ: Upstash Console > Redis > REST API
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Bank transfer — server-side only (không expose ra client)
# Hiển thị trong API response khi payment_method = bank_transfer
BANK_NAME=Vietcombank
BANK_ACCOUNT_NUMBER=1234567890
BANK_ACCOUNT_NAME=NGUYEN VAN A

# QR code ảnh chuyển khoản — public URL, server đưa vào bank_transfer_info response
NEXT_PUBLIC_BANK_QR_IMAGE_URL=https://your-bucket.supabase.co/storage/v1/object/public/product-images/bank-qr.png

# Số điện thoại hỗ trợ — hiển thị nút "Cần hỗ trợ?" trên trang tracking
# Nếu không set, nút vẫn hiển thị nhưng không có tel: link
NEXT_PUBLIC_SUPPORT_PHONE=0901234567
